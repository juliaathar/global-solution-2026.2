# Copie para 06-rpa/.env e preencha. O .env nunca vai para o git.
# Sem as três primeiras variáveis o canal de e-mail fica desligado.
RPA_SMTP_USUARIO=            # conta que envia, ex.: robo@exemplo.com
RPA_SMTP_SENHA=              # senha de app do Gmail (16 letras), nunca a senha da conta
RPA_EMAIL_DESTINO=           # quem recebe os avisos (gestor)
RPA_SMTP_HOST=smtp.gmail.com
RPA_SMTP_PORTA=587
RPA_EMAIL_URGENCIAS=alta     # urgências que geram e-mail, separadas por vírgula
RPA_API_URL=                 # endpoint do app (01-front-end/api); vazio = sem POST
RPA_HORARIOS=08:00,18:00     # horários da busca automática (python agendador.py servir)
