# Copie para .env e preencha. Nunca versione o .env.
LLM_PROVIDER=openai            # openai | gemini | groq | ollama | extrativo (sem LLM, só para testes)
LLM_MODEL=gpt-4o-mini          # gpt-4o-mini (openai) | gemini-2.0-flash | llama-3.3-70b-versatile (groq) | qwen2.5:7b (ollama)
LLM_API_KEY=                   # chave do provider (não precisa no ollama)
OLLAMA_URL=http://localhost:11434
API_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8501
STT_MODEL=small                # faster-whisper: base | small
TTS_ENGINE=piper               # piper | edge-tts
LLM_TIMEOUT_S=120               # voz (02): espera máxima por resposta do LLM; em CPU sem GPU use 900
BASE_CONHECIMENTO=rag          # voz (02): rag = corpus oficial via 03-generative-ai | stub = base fictícia (só testes)
