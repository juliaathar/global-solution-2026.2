# API do EloBairro com RAG (03), visão (04) e robô RPA (06). Contexto de build: raiz do repositório.
FROM python:3.12-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
COPY 01-front-end/requirements-base.txt 01-front-end/requirements.txt 01-front-end/
COPY 03-generative-ai/requirements.txt 03-generative-ai/
COPY 04-visao-computacional/codigo/requirements.txt 04-visao-computacional/codigo/
# torch em versão só de CPU (bem menor que a padrão com CUDA)
RUN pip install torch torchvision --index-url https://download.pytorch.org/whl/cpu \
 && pip install -r 01-front-end/requirements.txt
COPY 01-front-end/api 01-front-end/api
COPY 02-pln-voz 02-pln-voz
COPY 03-generative-ai 03-generative-ai
COPY 04-visao-computacional/codigo 04-visao-computacional/codigo
COPY 06-rpa 06-rpa
WORKDIR /app/01-front-end
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/saude')"
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
